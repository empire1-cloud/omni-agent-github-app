# Copy to backend/.env and fill in real values. Never commit backend/.env —
# it's already covered by .gitignore. Omni-Agent's own guardrails also
# hard-block **/.env* from being read or written by the agent itself.

# --- Database (optional — app boots fine without it; status-check demo
#     routes and Mongo-backed billing history return 503 until set) ---
MONGO_URL=
DB_NAME=omni_agent
# Where install/purchase/checkout audit logs (JSONL) are written. Defaults to
# backend/data/. On Vercel the filesystem is not kept between requests, so set
# MONGO_URL there (or point this at persistent storage); /api/health reports
# event_storage_durable=false until you do.
OMNI_AGENT_DATA_DIR=

# --- CORS ---
CORS_ORIGINS=*

# --- Stripe (self-serve Pro/Team checkout) ---
# Start in TEST MODE (sk_test_ / whsec_ from a test webhook) and verify the
# full flow before ever putting live keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Public base URL of this backend, used to build Stripe success/cancel
# redirect URLs AND the GitHub App's webhook/manifest-callback URLs, e.g.
# https://omni-agent-api.onrender.com
APP_BASE_URL=

# Public base URL of the marketing/pricing site (frontend/), used for the
# GitHub App manifest's `url` and post-install `setup_url`, e.g.
# https://omni-agent.onrender.com
FRONTEND_BASE_URL=

# --- GitHub App (Marketplace listing + billing webhook) ---
# Nothing below exists yet on your first deploy — visit
# GET /api/github/app/new once APP_BASE_URL/FRONTEND_BASE_URL are set and
# deployed, complete the manifest flow on github.com, then paste the
# values it shows you (once) into these:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Signs the one-time manifest `state` so the GitHub callback verifies on any
# instance (needed on serverless hosts like Vercel). Any long random string.
MANIFEST_STATE_SECRET=
# Optional — register the App under an org instead of your personal
# account, e.g. empire1-cloud. Leave blank for a personal-account App.
GITHUB_APP_OWNER_ORG=
# Optional — display name for the App (must be globally unique on GitHub,
# <=34 chars, can't contain "GitHub" unless your org is verified).
GITHUB_APP_NAME=Omni Agent
